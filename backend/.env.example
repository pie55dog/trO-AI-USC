# Copy to .env and fill in. Never commit the real .env.

# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

DATABASE_URL=sqlite:///./tro.db
MEDIA_DIR=./media
# true = also keep a copy of every photo/upload in the database (hosts that wipe the disk, like Render free).
MEDIA_IN_DB=false

# The mobile web app (LinkedIn sign-in redirects back here) and allowed browser origins.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# LinkedIn developer portal -> your app -> Products: add "Sign In with LinkedIn using OpenID Connect".
# Auth tab: copy the client id/secret and add the redirect URL below under "Authorized redirect URLs".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Shared secrets. Organizers send X-Admin-Key; bracelets send X-Bracelet-Key.
# If either is blank, those endpoints are disabled (never open).
ADMIN_API_KEY=
BRACELET_API_KEY=

# Transcription + conversation notes (any OpenAI-compatible API; default Groq,
# whose free plan needs no card: console.groq.com > API Keys). Leave blank and
# recordings are stored but wait until a key is added.
AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# AI_CHAT_MODEL=llama-3.3-70b-versatile

# EMAIL_BACKEND=apps_script sends over https through deploy/email-relay.gs (for hosts that block SMTP):
EMAIL_RELAY_URL=
EMAIL_RELAY_KEY=

# "console" saves emails to MEDIA_DIR/outbox as .eml files; "smtp" really sends.
EMAIL_BACKEND=console
EMAIL_FROM="Tro <your-address@gmail.com>"
# Gmail example: turn on 2-step verification, create an app password, then:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_STARTTLS=true
